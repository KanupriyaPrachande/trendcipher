# ── BrightData ─────────────────────────────────────────────────────────────
# Get these from app.brightdata.com → Proxies → Web Unlocker
BRIGHTDATA_USER=brd-customer-XXXX-zone-XXXX
BRIGHTDATA_PASS=your_brightdata_password

# ── YouTube Data API v3 (fallback) ──────────────────────────────────────────
# Get from console.cloud.google.com → APIs → YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here

# ── Ollama ──────────────────────────────────────────────────────────────────
# Which local model to use. Run: ollama pull llama3
OLLAMA_MODEL=llama3

# ── Streamlit ───────────────────────────────────────────────────────────────
# Optional: set a secret key if deploying
STREAMLIT_SECRET=change_me_in_production
